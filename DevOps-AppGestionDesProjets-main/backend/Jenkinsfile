pipeline {
    agent any
    tools {
        maven 'Maven_3' // Le nom exact que tu as mis dans "Tools" à l'étape 2
    }
    stages {
        stage('1. Checkout Code') {
                    steps {
                        // Utilise ton vrai lien GitHub et ta branche 'main'
                        git branch: 'main', url: 'https://github.com/hideyabargaoui2/5Arctic9-BargaouiHideya.git'
                    }
                }
      stage('2. Build & Test') {
                  steps {
                      dir('DevOps-AppGestionDesProjets-main/backend') {
                          sh 'mvn clean package -DskipTests' // Compile l'application en ignorant les tests qui bloquent
                      }
                  }
              }
             stage('3. SonarQube Analysis') {
                         steps {
                             dir('DevOps-AppGestionDesProjets-main/backend') {
                                 withSonarQubeEnv('SonarQube_Server') {
                                     // On force l'URL ici pour contourner le localhost
                                     sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.host.url=http://host.docker.internal:9000'
                                 }
                             }
                         }
                     }
              stage('4. Build Docker Image') {
                          steps {
                              dir('DevOps-AppGestionDesProjets-main/backend') {
                                  // Remplace par ton pseudo DockerHub
                                  sh 'docker build -t hidayadock/hideyabargaoui_5arctic9_gestionprojets:latest .'
                              }
                          }
                      }
                      stage('5. Push to DockerHub') {
                          steps {
                              // "dockerhub-credentials" est l'ID que tu as créé dans Jenkins à l'étape des clés de sécurité
                              withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                                  sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                                  sh 'docker push hidayadock/hideyabargaoui_5arctic9_gestionprojets:latest'
                              }
                          }
                      }
    }
}