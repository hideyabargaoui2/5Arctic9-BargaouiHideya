pipeline {
    agent any
    tools {
        maven 'Maven_3' // Le nom exact que tu as mis dans "Tools" à l'étape 2
    }
    stages {
        stage('1. Checkout Code') {
                    steps {
                        // Utilise ton vrai lien GitHub et ta branche 'main'
                        git branch: 'main', url: 'https://github.com/hideyabargaoui2/5Arctic9-BargaouiHideya.git'
                    }
                }
       stage('2. Build & Test') {
                   steps {
                       dir('backend') { // Jenkins entre dans le dossier backend
                           sh 'mvn clean package'
                       }
                   }
               }
       stage('3. SonarQube Analysis') {
                   steps {
                       dir('backend') { // Jenkins entre dans le dossier backend
                           withSonarQubeEnv('SonarQube_Server') {
                               sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                           }
                       }
                   }
               }
    }
}